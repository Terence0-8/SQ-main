{
  "name": "solitiquo",
  "version": "1.0.0",
  "description": "Média de référence pour l'analyse politique et sociale au Cameroun",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "css:minify": "node scripts/minify-css.js",
    "test": "echo \"Tests à configurer\" && exit 0",
    "migrate": "node-pg-migrate up --migrations-dir backend/migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir backend/migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir backend/migrations --migration-file-language js --template-file-name backend/migrations/template.js",
    "migrate:status": "node scripts/migrate-status.js",
    "migrate:validate": "node scripts/migrate-validate.js"
  },
  "keywords": [
    "politique",
    "cameroun",
    "media",
    "podcast"
  ],
  "author": "Solitiquo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "amadeus": "^11.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "geoip-lite": "^2.0.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "stripe": "^20.4.1",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.10",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
