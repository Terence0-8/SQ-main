# ============================================================
# Solitiquo — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer .env dans git
# ============================================================

# Serveur
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
ALLOWED_ORIGINS=https://solitiquo.com

# Base de données PostgreSQL
DB_USER=solitiquo
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solitiquo
DATABASE_URL=postgresql://solitiquo:votre_mot_de_passe@localhost:5432/solitiquo

# Sessions & Auth
SESSION_SECRET=chaine_aleatoire_longue_minimum_32_caracteres
JWT_SECRET=autre_chaine_aleatoire_longue_minimum_32_caracteres

# Cloudinary (stockage images/audio)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# DeepL (traductions automatiques)
DEEPL_API_KEY=votre_cle_deepl

# CinetPay (paiement Mobile Money / Afrique)
CINETPAY_API_KEY=votre_api_key
CINETPAY_SITE_ID=votre_site_id
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2/payment

# Stripe (paiement carte bancaire international)
# Clés test : https://dashboard.stripe.com/test/apikeys
# Clés live : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Générer via : stripe listen --forward-to localhost:5000/api/subscriptions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# OAuth Google
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=votre_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_client_secret

# OAuth Facebook
# https://developers.facebook.com/apps/
FACEBOOK_APP_ID=votre_app_id
FACEBOOK_APP_SECRET=votre_app_secret
